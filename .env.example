# ---- LLM provider keys (OpenAI-compatible endpoints) ----
# DashScope (Alibaba Cloud Model Studio, intl endpoint) - RECOMMENDED.
# One free-trial key serves all four dashscope_* providers in the fallback
# chain: qwen3.8-max, deepseek-v4-flash, glm-5.2, deepseek-v4-pro.
# Optional per-model key overrides (only when a model needs its own key,
# e.g. qwen3.8-max free quota lives on a second key):
#   DASHSCOPE_QWEN_API_KEY=
#   DASHSCOPE_DEEPSEEK_API_KEY=
#   DASHSCOPE_GLM_API_KEY=
#   DASHSCOPE_PRO_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_QWEN_MODEL=qwen3.8-max
DASHSCOPE_DEEPSEEK_MODEL=deepseek-v4-flash
DASHSCOPE_GLM_MODEL=glm-5.2
DASHSCOPE_PRO_MODEL=deepseek-v4-pro

# Gemini (Google AI Studio) - OpenAI-compatible endpoint
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash

# GLM (Z.ai / Zhipu) - OpenAI-compatible endpoint
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# Qwen (legacy slot; can reuse the DashScope key + intl endpoint)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max

# DeepSeek - OpenAI-compatible endpoint
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# NVIDIA NIM - OpenAI-compatible endpoint (first fallback in the chain)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.2

# OpenRouter - OpenAI-compatible endpoint (cheap extraction model; configurable)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- Telegram notifier ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Proxies (optional, comma-separated, supports http/socks5) ----
# Rotating residential proxies help avoid blocks on the gated browser sources
# (linkedin/indeed/glassdoor/naukri/internshala/hirist/wellfound).
PROXY_LIST=

# ---- Real Chrome profile (optional) ----
# Point at your Chrome User Data directory (e.g. C:\Users\You\AppData\Local\Google\Chrome\User Data)
# to reuse your existing LinkedIn/Naukri/Hirist logins — no login walls, no CAPTCHA.
# Chrome must be fully closed while the harness runs.
BROWSER_USER_DATA_DIR=

# ---- Aggregator official APIs ----
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
INDEED_PUBLISHER_ID=
